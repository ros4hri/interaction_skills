std_skills/Meta meta

# The LED groups to use for the effect.
# They are identified by their name (e.g., ["left_ear", "right_ear"]).
# An empty list means the effect is applied to all LED groups.
# The list of available LED groups should be exposed by the action server;
# it is suggested to use a read-only array of strings "led_groups" parameter for this purpose.
string[] led_groups

# The selected LED effect.
string EFFECT_SOLID_COLOR = "solid_color"
string EFFECT_RAINBOW = "rainbow"
string EFFECT_FADE = "fade"
string EFFECT_BLINK = "blink"
string EFFECT_FLOW = "flow"
string effect_type "solid_color"

# Used for effects:
# - EFFECT_SOLID_COLOR
# - EFFECT_FADE
# - EFFECT_BLINK
# - EFFECT_FLOW
interaction_skills/LedColor color

# Used for effects:
# - EFFECT_SOLID_COLOR
# - EFFECT_FADE
# - EFFECT_BLINK
# - EFFECT_FLOW
interaction_skills/LedColor secondary_color

# Duration in seconds of a single cycle of the effect.
# Used for effects:
# - EFFECT_RAINBOW
# - EFFECT_FADE
# - EFFECT_BLINK
# - EFFECT_FLOW
float32 cycle

# Number of times each effect cycle is repeated before the action is completed.
# A negative number will mean the action continues indefinitely until canceled.
# Used for effects:
# - EFFECT_RAINBOW
# - EFFECT_FADE
# - EFFECT_BLINK
# - EFFECT_FLOW
int32 loops

# For effects with two phases in a cycle
# (or two spatially separated partitions as in EFFECT_SOLID_COLOR),
# the proportion of the first one ([0., 1.])
# Used for effects:
# - EFFECT_SOLID_COLOR
# - EFFECT_FADE
# - EFFECT_BLINK
float32 partition 1.0

---
std_skills/Result result

---
std_skills/Feedback feedback
